# Konfigurationsdatei für Bürgerenergie Hugo Site - SERVER VERSION
# Wird auf wme00-buergerenergie vor dem Build in config.env kopiert.

# Mitgliederkarte: GeoJSON wird per scp vom thlx06 ins Home des Pacs geschoben
GEOJSON_SOURCE_PATH=/home/pacs/wme00/users/buergerenergie/data/mitgliederkarte.geojson

# Apache .htpasswd auf dem Pac (bcrypt, drei Vorstands-User)
HTPASSWD_SERVER_PATH=/home/pacs/wme00/users/buergerenergie/var/htpasswd/intern
