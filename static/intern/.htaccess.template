AuthType Basic
AuthName "Bürgerenergie Bösingen-Herrenzimmern eG — Interner Bereich"
# HTPASSWD_PATH wird vom Build-Script aus config.env.server eingesetzt
AuthUserFile __HTPASSWD_PATH__
Require valid-user

# Sicherheitsheader
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options nosniff
    Header always set X-Frame-Options DENY
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Kein Verzeichnis-Listing
Options -Indexes

# .htpasswd + .htaccess selbst nicht ausliefern
<FilesMatch "^\.(htaccess|htpasswd)$">
    Require all denied
</FilesMatch>
