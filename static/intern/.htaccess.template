AuthType Basic
AuthName "Bürgerenergie Bösingen-Herrenzimmern eG — Interner Bereich"
# HTPASSWD_PATH wird vom Build-Script aus config.env.server eingesetzt
AuthUserFile __HTPASSWD_PATH__
Require valid-user

# Sicherheitsheader
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options nosniff
    Header always set X-Frame-Options DENY
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# .htpasswd + .htaccess selbst nicht ausliefern (Apache 2.2-Syntax)
<Files ".htpasswd">
    Order deny,allow
    Deny from all
</Files>
<Files ".htaccess">
    Order deny,allow
    Deny from all
</Files>
